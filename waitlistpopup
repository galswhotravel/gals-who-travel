<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gals Who Travel — waitlist popup</title>
<meta name="robots" content="noindex">
<!-- Playfair Display isn't a system font — without loading it, browsers
     silently fall back to Georgia, which is why it looked "off". If the
     live site already loads Playfair Display itself, this link is
     redundant but harmless; otherwise it's needed for the real font to
     actually render. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&display=swap" rel="stylesheet">
<style>
  :root {
    --red: #FF1717;
    --red-dark: #D91212;
    --ink: #0B213E;
    --sand: #FAF6F1;
    --border: #E8E1D6;
    --fd: 'Playfair Display', Georgia, serif;
    --fb: 'Arial Nova', Arial, Helvetica, sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: var(--fb); background: #dfe3e8; color: var(--ink); }

  /* ---- demo page (not part of the component) ---- */
  .demo-page { max-width: 700px; margin: 0 auto; padding: 50px 20px; }
  .demo-page h1 { font-family: var(--fd); font-style: italic; font-size: 24px; margin: 0 0 8px; }
  .demo-page p { color: rgba(11,33,62,0.6); font-size: 13.5px; margin: 0 0 22px; }
  .demo-btn {
    appearance: none; border: none; cursor: pointer; font-family: inherit;
    display: inline-flex; align-items: center; gap: 6px; text-decoration: none;
    font-weight: 700; font-size: 14px; color: #fff; background: var(--red);
    padding: 13px 24px; border-radius: 12px; margin: 0 10px 10px 0;
  }
  .demo-btn.secondary { background: var(--ink); }
  .demo-note { font-size: 12px; color: rgba(11,33,62,0.5); margin-top: 14px; }

  /* ===================================================================
     GALS WHO TRAVEL — waitlist popup
     A condensed copy of /contact?tour_name=...&status=WAIT_LIST: same
     photo-left / form-right layout, same copy, same fields, same field
     order — just in a modal, with the trip pre-filled instead of typed.
  =================================================================== */

  .gwt-wl-overlay {
    position: fixed; inset: 0; z-index: 9999;
    display: flex; align-items: center; justify-content: center;
    background: rgba(11, 33, 62, 0.6);
    opacity: 0; visibility: hidden; padding: 16px;
    transition: opacity .25s ease, visibility 0s linear .25s;
  }
  .gwt-wl-overlay.is-open { opacity: 1; visibility: visible; transition: opacity .25s ease; }

  .gwt-wl-modal {
    position: relative;
    width: 100%; max-width: 960px; max-height: 94vh;
    background: var(--sand);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 30px 70px -15px rgba(11,33,62,.45);
    display: grid;
    grid-template-columns: 1fr;
    transform: translateY(18px) scale(.98);
    transition: transform .3s ease;
  }
  .gwt-wl-overlay.is-open .gwt-wl-modal { transform: translateY(0) scale(1); }
  @media (min-width: 760px) {
    .gwt-wl-modal { grid-template-columns: 42% 58%; max-height: 88vh; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gwt-wl-overlay, .gwt-wl-modal { transition-duration: .001ms !important; }
  }

  .gwt-wl-close {
    position: absolute; top: 14px; right: 14px; z-index: 5;
    width: 34px; height: 34px; border: none; border-radius: 50%;
    background: rgba(255,255,255,.92); color: var(--ink); font-size: 18px; line-height: 1;
    cursor: pointer; box-shadow: 0 2px 10px rgba(11,33,62,.2);
  }
  .gwt-wl-close:hover { background: #fff; }

  /* ---- left / top: photo ---- */
  .gwt-wl-photo {
    position: relative;
    min-height: 200px;
    background: var(--ink);
  }
  @media (min-width: 760px) { .gwt-wl-photo { min-height: 100%; } }

  .gwt-wl-photo img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  }
  .gwt-wl-photo-content {
    position: absolute; left: 20px; right: 20px; bottom: 18px; z-index: 2; color: #fff;
  }
  /* no gradient/tint over the photo — legibility comes from a soft shadow instead */
  .gwt-wl-photo-content * { text-shadow: 0 1px 10px rgba(0,0,0,.55); }

  .gwt-wl-eyebrow {
    font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    margin: 0 0 6px;
  }

  .gwt-wl-photo h2 {
    font-family: var(--fd); font-weight: 500; font-size: 26px; line-height: 1.15;
    margin: 0;
  }
  .gwt-wl-photo h2 em { font-style: italic; }

  /* ---- right / bottom: form panel ---- */
  .gwt-wl-panel { padding: 26px 24px 28px; overflow-y: auto; }

  .gwt-wl-kicker {
    display: flex; align-items: center; gap: 8px; margin-bottom: 10px;
  }
  .gwt-wl-kicker .dash { width: 18px; height: 2px; background: var(--red); }
  .gwt-wl-kicker span { color: var(--red); font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }

  .gwt-wl-panel h2 {
    font-family: var(--fd); font-weight: 500; font-size: 27px; line-height: 1.15;
    margin: 0 0 12px; color: var(--ink);
  }
  .gwt-wl-panel h2 em { font-style: italic; color: var(--red); }

  .gwt-wl-panel p {
    font-size: 13.5px; line-height: 1.6; color: rgba(11,33,62,.75); margin: 0 0 20px;
  }

  .gwt-wl-row { display: grid; grid-template-columns: 1fr; gap: 14px; margin-bottom: 14px; }
  @media (min-width: 480px) { .gwt-wl-row { grid-template-columns: 1fr 1fr; } }

  .gwt-wl-field label {
    display: block; font-size: 12.5px; font-weight: 700; color: var(--ink); margin-bottom: 6px;
  }
  .gwt-wl-field label .req { color: var(--red); }

  .gwt-wl-field input,
  .gwt-wl-field textarea {
    width: 100%; font-family: var(--fb); font-size: 14.5px; color: var(--ink);
    background: #fff; border: 1.5px solid var(--border); border-radius: 12px;
    padding: 11px 13px;
  }
  .gwt-wl-field textarea { resize: vertical; min-height: 64px; }
  .gwt-wl-field input::placeholder,
  .gwt-wl-field textarea::placeholder { color: rgba(11,33,62,.35); }
  .gwt-wl-field input:focus,
  .gwt-wl-field textarea:focus { outline: none; border-color: var(--red); }
  .gwt-wl-field .is-touched:invalid { border-color: var(--red); background: #FFF4F4; }

  .gwt-wl-field.full { margin-bottom: 16px; }

  .gwt-wl-submit {
    appearance: none; border: none; width: 100%; display: block;
    font-family: var(--fb); font-weight: 700; font-size: 15px; color: #fff;
    background: var(--red); padding: 15px 20px; border-radius: 12px; cursor: pointer;
  }
  .gwt-wl-submit:hover { background: var(--red-dark); }
  .gwt-wl-submit:disabled { opacity: .6; cursor: not-allowed; }

  .gwt-wl-reassure { text-align: center; font-size: 12px; color: rgba(11,33,62,.6); margin: 12px 0 0; }

  .gwt-wl-success { display: none; }

  .gwt-wl :focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
</style>
</head>
<body>

  <div class="demo-page">
    <h1>waitlist popup <em>demo</em></h1>
    <p>this is a condensed copy of the real /contact waitlist page, shown as a popup. click the class <code>js-gwt-waitlist</code> link below to see it. the other link has no such class, so it's untouched — it just goes straight to /contact as it does today.</p>
    <a href="/contact?tour_name=albania&date=2026-09-30&status=WAIT_LIST" class="demo-btn js-gwt-waitlist">join the waitlist — albania, 30 sep</a>
    <button type="button" class="demo-btn secondary" id="gwtDemoShowSuccess">preview success screen</button>
    <p class="demo-note">resize the window / open on your phone to see the mobile layout (photo stacks on top of the form).</p>
  </div>

  <div class="gwt-wl"></div>

<script>
(function () {
  'use strict';

  var SUBMIT_URL = '/api/waitlist'; // point this at the real backend
  var HERO_IMAGE = 'data:image/jpeg;base64,';

  function formatDate(iso) {
    var p = (iso || '').split('-');
    if (p.length !== 3) return iso || '';
    var months = ['january','february','march','april','may','june','july','august','september','october','november','december'];
    return parseInt(p[2], 10) + ' ' + months[parseInt(p[1], 10) - 1] + ' ' + p[0];
  }
  function titleCase(slug) {
    return (slug || '').replace(/-/g, ' ').replace(/\w\S*/g, function (t) {
      return t.charAt(0).toUpperCase() + t.slice(1).toLowerCase();
    });
  }
  function track(name, params) {
    try { window.dispatchEvent(new CustomEvent('gwt:' + name, { detail: params })); } catch (e) {}
    try {
      if (typeof window.gtag === 'function') window.gtag('event', name, params);
      else if (Array.isArray(window.dataLayer)) window.dataLayer.push(Object.assign({ event: name }, params));
    } catch (e) {}
  }

  var root = document.querySelector('.gwt-wl');
  root.innerHTML =
    '<div class="gwt-wl-overlay" id="gwtWlOverlay">' +
      '<div class="gwt-wl-modal" role="dialog" aria-modal="true" aria-labelledby="gwtWlHeading" tabindex="-1">' +
        '<button type="button" class="gwt-wl-close" id="gwtWlClose" aria-label="close">&times;</button>' +

        '<div class="gwt-wl-photo">' +
          '<img src="' + HERO_IMAGE + '" alt="gals who travel">' +
          '<div class="gwt-wl-photo-content">' +
            '<p class="gwt-wl-eyebrow">don’t miss out</p>' +
            '<h2>be first to know<br><em>if a space opens</em></h2>' +
          '</div>' +
        '</div>' +

        '<div class="gwt-wl-panel">' +
          '<div id="gwtWlFormView">' +
            '<div class="gwt-wl-kicker"><span class="dash"></span><span>the waitlist</span></div>' +
            '<h2 id="gwtWlHeading">grab your<br><em>spot</em></h2>' +
            '<p>the trip is fully booked rn but join the waitlist and be the first to know if a space becomes available!! you’ll then have 48 hours to secure your spot!!</p>' +

            '<form id="gwtWlForm" novalidate>' +
              '<div class="gwt-wl-row">' +
                '<div class="gwt-wl-field">' +
                  '<label for="gwtWlFirstName">First name <span class="req">*</span>:</label>' +
                  '<input type="text" id="gwtWlFirstName" name="firstName" placeholder="Jane" autocomplete="given-name" required>' +
                '</div>' +
                '<div class="gwt-wl-field">' +
                  '<label for="gwtWlLastName">Last name <span class="req">*</span>:</label>' +
                  '<input type="text" id="gwtWlLastName" name="lastName" placeholder="Smith" autocomplete="family-name" required>' +
                '</div>' +
              '</div>' +
              '<div class="gwt-wl-row">' +
                '<div class="gwt-wl-field">' +
                  '<label for="gwtWlEmail">Email address <span class="req">*</span>:</label>' +
                  '<input type="email" id="gwtWlEmail" name="email" placeholder="jane@email.com" autocomplete="email" required>' +
                '</div>' +
                '<div class="gwt-wl-field">' +
                  '<label for="gwtWlPhone">phone number:</label>' +
                  '<input type="tel" id="gwtWlPhone" name="phone" placeholder="+44 7700 900000" autocomplete="tel">' +
                '</div>' +
              '</div>' +
              '<div class="gwt-wl-row">' +
                '<div class="gwt-wl-field">' +
                  '<label for="gwtWlDob">date of birth <span class="req">*</span>:</label>' +
                  '<input type="text" id="gwtWlDob" name="dob" placeholder="01/01/2000" autocomplete="bday" required>' +
                '</div>' +
                '<div class="gwt-wl-field">' +
                  '<label for="gwtWlNationality">Nationality <span class="req">*</span>:</label>' +
                  '<input type="text" id="gwtWlNationality" name="nationality" placeholder="e.g. British" autocomplete="country-name" required>' +
                '</div>' +
              '</div>' +
              '<div class="gwt-wl-field full">' +
                '<label for="gwtWlMessage">Message <span class="req">*</span>:</label>' +
                '<textarea id="gwtWlMessage" name="message" required></textarea>' +
              '</div>' +
              '<button type="submit" class="gwt-wl-submit" id="gwtWlSubmit">join the waitlist</button>' +
            '</form>' +
          '</div>' +

          '<div class="gwt-wl-success" id="gwtWlSuccess">' +
            '<div class="gwt-wl-kicker"><span class="dash"></span><span>you’re in</span></div>' +
            '<h2 id="gwtWlSuccessHeading"></h2>' +
            '<p id="gwtWlSuccessCopy"></p>' +
            '<button type="button" class="gwt-wl-submit" id="gwtWlSuccessClose">back to browsing</button>' +
          '</div>' +
        '</div>' +

      '</div>' +
    '</div>';

  var overlay = document.getElementById('gwtWlOverlay');
  var modal = overlay.querySelector('.gwt-wl-modal');
  var closeBtn = document.getElementById('gwtWlClose');
  var formView = document.getElementById('gwtWlFormView');
  var successView = document.getElementById('gwtWlSuccess');
  var successHeading = document.getElementById('gwtWlSuccessHeading');
  var successCopy = document.getElementById('gwtWlSuccessCopy');

  function setSuccessHeading(firstName) {
    var name = (firstName || '').trim();
    successHeading.textContent = '';
    successHeading.appendChild(document.createTextNode(name ? name + ', you’re on' : 'you’re on'));
    successHeading.appendChild(document.createElement('br'));
    var em = document.createElement('em');
    em.textContent = 'the list!!';
    successHeading.appendChild(em);
    successHeading.appendChild(document.createTextNode(' 🎉'));
  }
  var form = document.getElementById('gwtWlForm');
  var messageField = document.getElementById('gwtWlMessage');
  var submitBtn = document.getElementById('gwtWlSubmit');

  var currentTrip = null, isOpen = false, formStarted = false, lastFocused = null;

  function open(trip) {
    currentTrip = trip;
    formStarted = false;
    lastFocused = document.activeElement;

    form.reset();
    form.querySelectorAll('.is-touched').forEach(function (f) { f.classList.remove('is-touched'); });
    messageField.value = 'I am interested in joining the waitlist for ' + trip.name.toLowerCase() + ' tour on the ' + trip.dateIso + '.';

    formView.style.display = '';
    successView.style.display = 'none';

    overlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    isOpen = true;
    history.pushState({ gwtWaitlist: true }, '', location.href);
    window.requestAnimationFrame(function () { modal.focus(); });

    track('waitlist_popup_view', { trip_name: trip.name, trip_date: trip.dateIso, source: location.pathname });
  }

  function close(reason, fromPopState) {
    if (!isOpen) return;
    isOpen = false;
    overlay.classList.remove('is-open');
    document.body.style.overflow = '';
    track('waitlist_popup_close', { trip_name: currentTrip && currentTrip.name, close_reason: reason || 'unknown' });
    if (!fromPopState && history.state && history.state.gwtWaitlist) history.back();
    if (lastFocused && lastFocused.focus) lastFocused.focus();
  }

  closeBtn.addEventListener('click', function () { close('close_button'); });
  var successCloseBtn = document.getElementById('gwtWlSuccessClose');
  successCloseBtn.addEventListener('click', function () { close('success_cta'); });
  overlay.addEventListener('mousedown', function (e) { if (e.target === overlay) close('backdrop'); });
  document.addEventListener('keydown', function (e) {
    if (!isOpen) return;
    if (e.key === 'Escape') { close('esc'); return; }
    if (e.key === 'Tab') {
      var f = modal.querySelectorAll('button, input, select, textarea, [tabindex]:not([tabindex="-1"])');
      if (!f.length) return;
      var first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
  window.addEventListener('popstate', function (e) {
    if (isOpen && (!e.state || !e.state.gwtWaitlist)) close('back_button', true);
  });

  form.addEventListener('input', function () {
    if (!formStarted) { formStarted = true; track('waitlist_form_start', { trip_name: currentTrip.name, trip_date: currentTrip.dateIso }); }
  });
  form.addEventListener('blur', function (e) {
    if (e.target && e.target.matches('input, textarea')) e.target.classList.add('is-touched');
  }, true);

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    track('waitlist_popup_cta_click', { trip_name: currentTrip.name, trip_date: currentTrip.dateIso });

    if (!form.reportValidity()) {
      form.querySelectorAll('input, textarea').forEach(function (f) { f.classList.add('is-touched'); });
      return;
    }

    var data = {
      firstName: form.firstName.value.trim(),
      lastName: form.lastName.value.trim(),
      email: form.email.value.trim(),
      phone: form.phone.value.trim(),
      dob: form.dob.value.trim(),
      nationality: form.nationality.value.trim(),
      message: form.message.value.trim(),
      tourName: currentTrip.slug,
      date: currentTrip.dateIso,
      status: 'WAIT_LIST'
    };

    submitBtn.disabled = true;
    submitBtn.textContent = 'popping you on...';

    (window.GWTWaitlistSubmit || defaultSubmit)(data)
      .then(function () {
        track('waitlist_form_submit', { trip_name: currentTrip.name, trip_date: currentTrip.dateIso });
        setSuccessHeading(data.firstName);
        successCopy.textContent = 'you’re on the waitlist!! if a space becomes available, you’ll be the first to know!!';
        formView.style.display = 'none';
        successView.style.display = 'block';
      })
      .catch(function () {
        alert('hmm, something went wrong sending that. mind trying again?');
      })
      .finally(function () {
        submitBtn.disabled = false;
        submitBtn.textContent = 'join the waitlist';
      });
  });

  function defaultSubmit(data) {
    return fetch(SUBMIT_URL, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data)
    }).then(function (res) { if (!res.ok) throw new Error('failed'); });
  }

  function tripFromLink(el) {
    var qs = new URLSearchParams((el.getAttribute('href') || '').split('?')[1] || '');
    var slug = el.dataset.tripSlug || qs.get('tour_name') || '';
    return {
      slug: slug,
      name: el.dataset.tripName || titleCase(slug),
      dateIso: el.dataset.tripDate || qs.get('date') || '',
      status: (el.dataset.tripStatus || qs.get('status') || '').toUpperCase()
    };
  }

  document.querySelectorAll('.js-gwt-waitlist').forEach(function (el) {
    el.addEventListener('click', function (e) {
      var trip = tripFromLink(el);
      if (trip.status !== 'WAIT_LIST' || !trip.dateIso) return; // fail open to the real /contact link
      e.preventDefault();
      open(trip);
    });
  });

  // demo-only: jumps straight to the success screen so it can be previewed without
  // filling in and submitting the form. Not part of the real integration.
  var demoShowSuccess = document.getElementById('gwtDemoShowSuccess');
  if (demoShowSuccess) {
    demoShowSuccess.addEventListener('click', function () {
      var trip = { slug: 'albania', name: 'Albania', dateIso: '2026-09-30', status: 'WAIT_LIST' };
      open(trip);
      setSuccessHeading('Jess');
      successCopy.textContent = 'you’re on the waitlist!! if a space becomes available, you’ll be the first to know!!';
      formView.style.display = 'none';
      successView.style.display = 'block';
    });
  }

})();
</script>
</body>
</html>
